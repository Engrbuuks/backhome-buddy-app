{
  "crons": [
    {
      "path": "/api/cron/auto-release",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/offers",
      "schedule": "17 4 * * *"
    },
    {
      "path": "/api/cron/subscriptions",
      "schedule": "23 5 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=*, microphone=*, geolocation=*"
        }
      ]
    }
  ]
}
