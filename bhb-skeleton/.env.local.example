# ── Supabase ──────────────────────────────────────────────
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. NEVER expose to the browser. Bypasses RLS — used only by trusted server code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Payments (add when wiring the payments step) ──────────
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# ── App ───────────────────────────────────────────────────
# The ONLY place NEXT_PUBLIC_APP_URL is set. It is the base for every link in
# every outgoing email, so a wrong value here sends clients to the wrong site.
#   local dev  → http://localhost:3000
#   production → https://app.backhomebuddy.ng   (set this in Vercel, lowercase)
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=generate-a-long-random-string

# ── AI support assistant ──
# Provider priority: Gemini first (free tier, no card — aistudio.google.com),
# then Anthropic. Neither set → chat falls back to "team notified".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Email notifications (optional but recommended) ──
# Resend free tier: resend.com — verify backhomebuddy.ng, then paste the key.
# Without a key, the app silently uses in-app notifications only.
RESEND_API_KEY=
EMAIL_FROM=Backhome Buddy <notifications@backhomebuddy.ng>
# (NEXT_PUBLIC_APP_URL is set once, in the App block above — do not repeat it
#  here. A second declaration wins over the first and quietly points local dev
#  emails at production.)

# ── Supabase Auth "Send Email" hook (replaces SMTP) ──
# Supabase → Authentication → Hooks → Send Email → HTTPS endpoint:
#   https://app.backhomebuddy.ng/api/auth/send-email
# Copy the generated secret (whsec_...) here:
SEND_EMAIL_HOOK_SECRET=

# Reply-to address for buddy document-request emails (defaults to support@backhomebuddy.ng)
SUPPORT_EMAIL=support@backhomebuddy.ng

# ── Cloudflare R2 storage (proof + vetting files) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PROOFS=bhb-proofs
R2_BUCKET_VETTING=bhb-vetting
