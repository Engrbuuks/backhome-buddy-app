# ── Supabase ──────────────────────────────────────────────
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. NEVER expose to the browser. Bypasses RLS — used only by trusted server code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Payments ──────────────────────────────────────────────
# PAYSTACK_SECRET_KEY is the only one of these the code reads today. It powers
# the free bank account name check used in buddy vetting. Without it the bank
# dropdown becomes a free-text box and no account is ever verified.
PAYSTACK_SECRET_KEY=
# The three below are read by NO code yet — the card webhooks are still stubs
# and there is no provider implementation. Setting them achieves nothing until
# the payments step is actually wired.
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# ── App ───────────────────────────────────────────────────
# Defined ONCE. It used to appear twice in this file, localhost here and the
# live domain further down, so whichever your loader kept decided where every
# password reset and quote link in every email pointed.
# In production set this to https://app.backhomebuddy.ng
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required, and the app fails CLOSED without it: both scheduled jobs return 401
# on every run, silently. Auto-release stops advancing tasks and offers stop
# expiring, with no banner anywhere. Generate a long random string.
CRON_SECRET=

# ── Company details printed on client-facing documents ────
# COMPANY_PHONE appears on every branded quote PDF. Leave it blank rather than
# guessing: the PDF omits the line, which is better than printing a number
# that reaches a stranger.
COMPANY_PHONE=
COMPANY_EMAIL=hello@backhomebuddy.ng
# Where interview invitations send candidates. If this is wrong they hit a dead
# booking page and you never hear from them again.
CALENDLY_INTERVIEW_URL=
# The public site the support knowledge base is built from.
WEBSITE_URL=https://backhomebuddy.ng

# ── AI support assistant ──
# Provider priority: Gemini first (free tier, no card — aistudio.google.com),
# then Anthropic. Neither set → chat falls back to "team notified".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Email notifications (optional but recommended) ──
# Resend free tier: resend.com — verify backhomebuddy.ng, then paste the key.
# Without a key, the app silently uses in-app notifications only.
RESEND_API_KEY=
EMAIL_FROM=Backhome Buddy <notifications@backhomebuddy.ng>

# ── Supabase Auth "Send Email" hook (replaces SMTP) ──
# Supabase → Authentication → Hooks → Send Email → HTTPS endpoint:
#   https://app.backhomebuddy.NG/api/auth/send-email
# Copy the generated secret (whsec_...) here:
SEND_EMAIL_HOOK_SECRET=

# Reply-to address for buddy document-request emails (defaults to support@backhomebuddy.ng)
SUPPORT_EMAIL=support@backhomebuddy.ng

# ── Cloudflare R2 storage (proof + vetting files) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PROOFS=bhb-proofs
R2_BUCKET_VETTING=bhb-vetting

# ── Web push (phone alerts for task offers) ───────────────
# Generate once with:  npx web-push generate-vapid-keys
# With these unset, push quietly does nothing and the rest of the app is
# unaffected — so you can deploy first and turn alerts on afterwards.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@backhomebuddy.ng
